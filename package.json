{
  "name": "ribongrant_calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "description": "Application de gestion de calendrier avec assignation de membres",
  "author": "Ribongrant",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:api": "node --watch server/index.js",
    "dev:all": "concurrently -c auto \"npm:dev\" \"npm:dev:api\"",
    "electron:dev": "concurrently -c auto \"npm:dev\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build:electron": "npm run build && electron-builder --win portable",
    "build:electron:installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "electron": "^44.9.2",
    "electron-builder": "^26.5.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wait-on": "^8.0.4"
  }
}
